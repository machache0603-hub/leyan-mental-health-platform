<?xml version="1.0" encoding="UTF-8"?>

<Controller>
    <name>ResourceController</name>
    <isv></isv>
    <app>portal</app>
    <version>1</version>
    <url></url>
    <scriptFile>ResourceController.ts</scriptFile>
    <methods>
        <method>
            <name>list</name>
            <url>/resource/list</url>
            <httpMethod>GET</httpMethod>
            <permission>
                <permission>
                    <permitAll></permitAll>
                    <anonymousUser>false</anonymousUser>
                    <entityNumber>ly_resource</entityNumber>
                    <permItemId></permItemId>
                    <checkRightApp></checkRightApp>
                </permission>
            </permission>
        </method>
        <method>
            <name>create</name>
            <url>/resource/create</url>
            <httpMethod>POST</httpMethod>
            <permission>
                <permission>
                    <permitAll></permitAll>
                    <anonymousUser>false</anonymousUser>
                    <entityNumber>ly_resource</entityNumber>
                    <permItemId></permItemId>
                    <checkRightApp></checkRightApp>
                </permission>
            </permission>
        </method>
        <method>
            <name>update</name>
            <url>/resource/update</url>
            <httpMethod>POST</httpMethod>
            <permission>
                <permission>
                    <permitAll></permitAll>
                    <anonymousUser>false</anonymousUser>
                    <entityNumber>ly_resource</entityNumber>
                    <permItemId></permItemId>
                    <checkRightApp></checkRightApp>
                </permission>
            </permission>
        </method>
        <method>
            <name>toggle</name>
            <url>/resource/toggle</url>
            <httpMethod>POST</httpMethod>
            <permission>
                <permission>
                    <permitAll></permitAll>
                    <anonymousUser>false</anonymousUser>
                    <entityNumber>ly_resource</entityNumber>
                    <permItemId></permItemId>
                    <checkRightApp></checkRightApp>
                </permission>
            </permission>
        </method>
        <method>
            <name>remove</name>
            <url>/resource/remove</url>
            <httpMethod>POST</httpMethod>
            <permission>
                <permission>
                    <permitAll></permitAll>
                    <anonymousUser>false</anonymousUser>
                    <entityNumber>ly_resource</entityNumber>
                    <permItemId></permItemId>
                    <checkRightApp></checkRightApp>
                </permission>
            </permission>
        </method>
    </methods>
</Controller>
