<?xml version="1.0" encoding="UTF-8"?>

<Controller>
    <name>DiaryController</name>
    <isv></isv>
    <app>portal</app>
    <version>1</version>
    <url></url>
    <scriptFile>DiaryController.ts</scriptFile>
    <methods>
        <method>
            <name>list</name>
            <url>/diary/list</url>
            <httpMethod>GET</httpMethod>
            <permission>
                <permission>
                    <permitAll></permitAll>
                    <anonymousUser>false</anonymousUser>
                    <entityNumber>ly_diary</entityNumber>
                    <permItemId></permItemId>
                    <checkRightApp></checkRightApp>
                </permission>
            </permission>
        </method>
        <method>
            <name>create</name>
            <url>/diary/create</url>
            <httpMethod>POST</httpMethod>
            <permission>
                <permission>
                    <permitAll></permitAll>
                    <anonymousUser>false</anonymousUser>
                    <entityNumber>ly_diary</entityNumber>
                    <permItemId></permItemId>
                    <checkRightApp></checkRightApp>
                </permission>
            </permission>
        </method>
    </methods>
</Controller>
