<?xml version="1.0" encoding="UTF-8"?>

<Controller>
    <name>ScoreController</name>
    <isv></isv>
    <app>portal</app>
    <version>1</version>
    <url></url>
    <scriptFile>ScoreController.ts</scriptFile>
    <methods>
        <method>
            <name>importScore</name>
            <url>/score/importScore</url>
            <httpMethod>POST</httpMethod>
            <permission>
                <permission>
                    <permitAll></permitAll>
                    <anonymousUser>false</anonymousUser>
                    <entityNumber>ly_score</entityNumber>
                    <permItemId></permItemId>
                    <checkRightApp></checkRightApp>
                </permission>
            </permission>
        </method>
        <method>
            <name>listScores</name>
            <url>/score/listScores</url>
            <httpMethod>POST</httpMethod>
            <permission>
                <permission>
                    <permitAll></permitAll>
                    <anonymousUser>false</anonymousUser>
                    <entityNumber>ly_score</entityNumber>
                    <permItemId></permItemId>
                    <checkRightApp></checkRightApp>
                </permission>
            </permission>
        </method>
        <method>
            <name>moodPrediction</name>
            <url>/score/moodPrediction</url>
            <httpMethod>POST</httpMethod>
            <permission>
                <permission>
                    <permitAll></permitAll>
                    <anonymousUser>false</anonymousUser>
                    <entityNumber>ly_score</entityNumber>
                    <permItemId></permItemId>
                    <checkRightApp></checkRightApp>
                </permission>
            </permission>
        </method>
        <method>
            <name>teacherPerformance</name>
            <url>/score/teacherPerformance</url>
            <httpMethod>POST</httpMethod>
            <permission>
                <permission>
                    <permitAll></permitAll>
                    <anonymousUser>false</anonymousUser>
                    <entityNumber>ly_teacher_performance</entityNumber>
                    <permItemId></permItemId>
                    <checkRightApp></checkRightApp>
                </permission>
            </permission>
        </method>
    </methods>
</Controller>
