# 乐颜 · 真实后端环境变量（复制为 server/.env，已 gitignore）
#
# 数据库连接：与 docker-compose.yml 里的 postgres 服务一致即可。
# 也可指向你已有的 PostgreSQL（赛题要求 PostgreSQL）。

PORT=8788

# —— 方式一：分项配置（默认，对应 docker-compose 的 db 服务）——
PGHOST=localhost
PGPORT=5432
PGUSER=leyan
PGPASSWORD=leyan
PGDATABASE=leyan

# —— 方式二：整串连接（填了它则优先用它，覆盖上面分项）——
# DATABASE_URL=postgres://leyan:leyan@localhost:5432/leyan

# 允许跨域来源（前端 dev 地址）；上线改成你的域名
CORS_ORIGIN=*
