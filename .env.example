# 乐颜 · 前端环境变量（复制为 .env.local，已 gitignore）
#
# 默认不配 = 用规则模拟(mock)，无需任何 key 即可演示。
# 想用真实大模型：设为 llm，并启动代理后端(见 proxy/.env.example)。

# 开启真实模型（经代理调用 DeepSeek/豆包/通义）
VITE_AI_BACKEND=llm

# 代理后端地址（默认 localhost:8787，与 proxy 一致即可）
VITE_LLM_PROXY=http://localhost:8787

# 注意：前端这里不放任何 API Key —— key 只在 proxy/.env（服务端）。

# ── 数据后端选择 ──────────────────────────────
# local  = 浏览器 localStorage（无需后端，刷新不丢）
# server = 本地真实后端 Node + PostgreSQL（npm run dev:all 会按 PG 是否在线自动设置）
# cosmic = 金蝶苍穹控制器（部署到苍穹后由运行时自动识别）
# 留空 = 自动：检测到苍穹用 cosmic，否则 local
VITE_DATA_BACKEND=server

# 真实后端地址（server 模式用，默认 localhost:8788）
VITE_SERVER_BASE=http://localhost:8788
